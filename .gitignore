# Environment variables & secrets (NEVER commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.keystore
aws-credentials
credentials
secrets.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
target/
out/
*.egg-info/

# Frontend testing & coverage
coverage/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Maven Wrapper & cache
.mvn/.lock
*.class
